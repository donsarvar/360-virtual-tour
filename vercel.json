{
  "headers": [
    {
      "source": "/(botanika|islamic-center|ecopark)/(.*)\\.(webp|jpg|png|mp3|m4a)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
